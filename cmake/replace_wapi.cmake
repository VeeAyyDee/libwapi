# Include after ESP-IDF project(). Add this component directory to
# EXTRA_COMPONENT_DIRS before project().
if(NOT DEFINED CLEAN_WAPI_COMPONENT_TARGET)
    set(CLEAN_WAPI_COMPONENT_TARGET __idf_libwapi)
endif()
if(NOT TARGET ${CLEAN_WAPI_COMPONENT_TARGET})
    message(FATAL_ERROR "Fresh WAPI component target ${CLEAN_WAPI_COMPONENT_TARGET} is missing")
endif()
if(NOT TARGET esp_wifi_wapi)
    message(FATAL_ERROR "Pinned SDK imported target esp_wifi_wapi is missing")
endif()
idf_build_get_property(_wapi_idf_target IDF_TARGET)
if(NOT _wapi_idf_target STREQUAL "esp32s3")
    message(FATAL_ERROR "Fresh WAPI is pinned to esp32s3, got ${_wapi_idf_target}")
endif()
if(NOT IDF_VERSION_MAJOR EQUAL 6 OR NOT IDF_VERSION_MINOR EQUAL 0 OR NOT IDF_VERSION_PATCH EQUAL 3)
    message(FATAL_ERROR "Fresh WAPI is pinned to ESP-IDF 6.0.3, got ${IDF_VERSION_MAJOR}.${IDF_VERSION_MINOR}.${IDF_VERSION_PATCH}")
endif()
get_target_property(_wapi_binary_dir ${CLEAN_WAPI_COMPONENT_TARGET} BINARY_DIR)
set(_wapi_archive "${_wapi_binary_dir}/libwapi.a")
set_target_properties(esp_wifi_wapi PROPERTIES IMPORTED_LOCATION "${_wapi_archive}")
get_target_property(_wapi_configs esp_wifi_wapi IMPORTED_CONFIGURATIONS)
if(_wapi_configs)
    foreach(_wapi_config IN LISTS _wapi_configs)
        string(TOUPPER "${_wapi_config}" _wapi_config_upper)
        set_property(TARGET esp_wifi_wapi PROPERTY IMPORTED_LOCATION_${_wapi_config_upper} "${_wapi_archive}")
    endforeach()
endif()
message(STATUS "esp_wifi_wapi redirected to ${_wapi_archive}")
